# Copy to .env and fill in real values. Never commit .env.
# AWS credentials are NOT set here — containers get them from the EC2
# instance role (CSE363-EC2-Role) via instance metadata. Only secrets that
# have no other source (database passwords) live in this file.

AWS_REGION=
DOCUMENTS_BUCKET=
QUIZZES_BUCKET=
SQS_QUEUE_URL=
SNS_TOPIC_ARN=

DB_HOST=
DB_PORT=5432

DOCS_DB_NAME=
DOCS_DB_USER=
DOCS_DB_PASSWORD=

QUIZ_DB_NAME=
QUIZ_DB_USER=
QUIZ_DB_PASSWORD=
