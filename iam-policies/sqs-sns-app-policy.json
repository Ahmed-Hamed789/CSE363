{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentProcessingQueueAccess",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:339879234587:document-processing"
    },
    {
      "Sid": "QuizReadyTopicPublish",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:339879234587:quiz-ready"
    }
  ]
}
