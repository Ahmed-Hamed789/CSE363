{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentsBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::cse363-documents"
    },
    {
      "Sid": "DocumentsObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::cse363-documents/*"
    }
  ]
}
